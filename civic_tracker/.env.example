# Copy to .env and fill in. .env is git-ignored.
# Omit the password to use ~/.pgpass.
DATABASE_URL=postgresql://postgres@DB_HOST:5400/Davis

LLM_BASE_URL=http://LLM_HOST:8000/v1
LLM_API_KEY=local
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_MAX_CONCURRENCY=6

EMBED_BASE_URL=http://EMBED_HOST:8002/v1
EMBED_API_KEY=local
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
EMBED_DIM=1024

# cpu | cuda:0
COREF_DEVICE=cpu
GLINER_DEVICE=cpu

CRAWL_DELAY_SECONDS=5

# History walk: queue older articles after each scheduled crawl, back to this date
HISTORY_ENABLED=true
HISTORY_BATCH_PER_SOURCE=20
CRAWL_HISTORY_FLOOR=2015-01-01

# API burst (admin -> Control center -> API burst). DeepSeek's own API; verify model id + prices at
# https://api-docs.deepseek.com before use. Spend is estimated from token usage x these prices.
BURST_LLM_API_KEY=
BURST_LLM_BASE_URL=https://api.deepseek.com
BURST_LLM_MODEL=deepseek-flash
BURST_RESPONSE_FORMAT=json_object
# BURST_EXTRA_BODY={"thinking": {"type": "disabled"}}
BURST_CONCURRENCY=8
BURST_PRICE_INPUT_PER_M=0.30
BURST_PRICE_OUTPUT_PER_M=1.20
BURST_DEFAULT_SPEND_CAP_USD=5
